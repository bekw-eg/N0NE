# Set locally; never commit the real key.
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice

# Open-Meteo needs no API key for this non-commercial MVP. Export explicitly.
WEATHER_TIMEOUT_SECONDS=5
WEATHER_FORECAST_HOURS=3
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_FAILURE_TTL_SECONDS=30
WEATHER_CACHE_MAX_ENTRIES=4
# Product heuristics, not official hazardous-weather criteria.
WEATHER_WIND_KMH=35
WEATHER_PRECIPITATION_MM=2
WEATHER_COLD_C=0
WEATHER_PRECIPITATION_PROBABILITY=70
