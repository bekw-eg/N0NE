# Export explicitly, or pass --env-file .env to uvicorn after copying this file.
# Relative paths are resolved against the process working directory.
POI_DATASET_PATH=../../data/astana/pois.json
CORS_ORIGINS=["http://localhost:3000"]
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Enable after pulling the model and optionally warming the index.
SEMANTIC_ENABLED=false
EMBEDDING_INDEX_DIR=../../data/tmp/embeddings
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60
INDEX_BUILD_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
SEMANTIC_MIN_SCORE=0.35
CONTEXT_MAX_BYTES=24000
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_TIMEOUT_SECONDS=10
ROUTE_MAX_CANDIDATES=10
ROUTE_NEARBY_RADIUS_M=2500
ROUTE_SNAP_RADIUS_M=100
PRIVACY_MAX_ANCHOR_DISTANCE_M=3000
WEATHER_TIMEOUT_SECONDS=5
WEATHER_FORECAST_HOURS=3
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_FAILURE_TTL_SECONDS=30
WEATHER_CACHE_MAX_ENTRIES=4
# Walking heuristics, not official hazardous-weather criteria.
WEATHER_WIND_KMH=35
WEATHER_PRECIPITATION_MM=2
WEATHER_COLD_C=0
WEATHER_PRECIPITATION_PROBABILITY=70
